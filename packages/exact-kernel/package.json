{
  "name": "@crispcad/exact-kernel",
  "version": "0.1.5",
  "description": "Exact B-rep kernel with an MIT + Apache-2.0 closure: a narrow ExactKernel interface on SMLib (smlibwasm 0.6.2, built from source and prebundled without its font). From the CrispCAD kernel lab.",
  "license": "MIT AND Apache-2.0",
  "author": "CrispCAD contributors",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrispStrobe/crispcad-kernel-lab.git",
    "directory": "packages/exact-kernel"
  },
  "homepage": "https://github.com/CrispStrobe/crispcad-kernel-lab/tree/main/packages/exact-kernel#readme",
  "keywords": ["cad", "brep", "step", "smlib", "webassembly"],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./smlibwasm.wasm": "./dist/smlibwasm.wasm",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "BUILD-PROVENANCE.json",
    "licenses",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node scripts/build.mjs",
    "build:smlibwasm": "sh scripts/build-smlibwasm.sh",
    "release": "sh scripts/release.sh"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
